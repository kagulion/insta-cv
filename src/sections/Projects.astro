---
import type { Cv } from '../config';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import TagList from '../components/TagList.astro';

interface Props {
  readonly cv: Cv;
}

const { cv } = Astro.props;
const projects = cv.projects ?? [];
---

<ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 print:grid-cols-2">
  {projects.map(({ name, url, description, tech }) => (
    <li
      class:list={[
        'reveal has-[a:focus-visible]:outline-foreground relative flex min-w-0 flex-col rounded-lg border p-4 has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-2',
        url !== undefined && 'project-card group'
      ]}
    >
      <h3 class="flex items-start justify-between gap-2 text-base leading-snug font-medium tracking-tight">
        {url !== undefined ? (
          <>
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              class="outline-none after:absolute after:inset-0 after:rounded-lg"
            >
              {name}
            </a>
            <ArrowUpRight class="project-arrow size-4 shrink-0 print:hidden" aria-hidden="true" />
          </>
        ) : (
          name
        )}
      </h3>
      {description !== undefined && (
        <p class="text-muted-foreground mt-0.5 text-[0.8125rem] leading-snug">{description}</p>
      )}
      <div class="mt-auto pt-3">
        <TagList items={tech ?? []} max={6} />
      </div>
    </li>
  ))}
</ul>
