---
import type { Cv } from '../config';
import { joinFilled } from '../lib/text';

interface Props {
  readonly cv: Cv;
}

const { cv } = Astro.props;
const entries = (cv.recommendations ?? []).map(({ quote, author, role, company }) => ({
  quote,
  signature: joinFilled([author, role, company], ', ')
}));
---

<ul class="space-y-5 print:space-y-3">
  {entries.map(({ quote, signature }) => (
    <li class="reveal">
      <figure class="flex flex-col items-end pr-2">
        <blockquote class="bg-border/60 relative max-w-full rounded-2xl rounded-br-none px-4 py-2.5 after:absolute after:right-[-8px] after:bottom-0 after:size-2 after:bg-border/60 after:[clip-path:polygon(0_0,100%_100%,0_100%)] after:content-['']">
          <p class="text-sm leading-snug text-pretty">{quote}</p>
        </blockquote>
        <figcaption class="text-muted-foreground mt-1.5 text-xs">{signature}</figcaption>
      </figure>
    </li>
  ))}
</ul>
