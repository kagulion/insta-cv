---
import type { Cv } from '../config';
import RowList from '../components/RowList.astro';
import { joinFilled } from '../lib/text';

interface Props {
  readonly cv: Cv;
}

const { cv } = Astro.props;
const rows = (cv.certificates ?? []).map(({ title, issuer, year }) => ({
  title,
  details: joinFilled([issuer], ', '),
  ...(year === undefined ? {} : { aside: String(year) })
}));
---

<RowList rows={rows} />
