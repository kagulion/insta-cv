---
import type { Cv } from '../config';
import RowList from '../components/RowList.astro';
import { joinFilled } from '../lib/text';

interface Props {
  readonly cv: Cv;
}

const { cv } = Astro.props;
const rows = (cv.education ?? []).map(({ institution, degree, field, period }) => ({
  title: institution,
  details: joinFilled([degree, field], ', '),
  ...(period === undefined ? {} : { aside: period })
}));
---

<RowList rows={rows} />
