---
import type { Cv } from '../config';
import { languageParts } from '../lib/languages';

interface Props {
  readonly cv: Cv;
}

const { cv } = Astro.props;
const lines = (cv.languages ?? []).map(languageParts);
---

<ul class="space-y-1 text-sm">
  {lines.map(({ name, rest }) => (
    <li>
      <span class="font-medium">{name}</span>
      {rest}
    </li>
  ))}
</ul>
