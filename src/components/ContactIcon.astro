---
import Link from '@lucide/astro/icons/link';
import Mail from '@lucide/astro/icons/mail';
import Smartphone from '@lucide/astro/icons/smartphone';
import brands from '@iconify-json/fa6-brands/icons.json';
import { findBrandIcon } from '../config/link-icons';
import type { ContactItemKind } from '../lib/contact-links';

interface Props {
  readonly kind: ContactItemKind;
  /** Имя иконки для `kind: 'link'`: бренд из FA6 или `link`. */
  readonly icon?: string;
}

const BASIC = { phone: Smartphone, email: Mail } as const;
const BRANDS = { telegram: 'telegram', github: 'github', linkedin: 'linkedin' } as const;

const { kind, icon } = Astro.props;
const Basic = kind in BASIC ? BASIC[kind as keyof typeof BASIC] : undefined;
const brandName =
  kind === 'link' ? icon : kind in BRANDS ? BRANDS[kind as keyof typeof BRANDS] : undefined;
const brandIcon = brandName === undefined ? undefined : findBrandIcon(brandName);
const brandBody = brandIcon?.body;
// У части иконок своя ширина (telegram, github шире общей): иначе viewBox обрезает их справа.
const brandWidth = brandIcon?.width ?? brands.width;
// Своя ссылка без известного бренда получает общую иконку «ссылка».
const Generic = kind === 'link' && brandIcon === undefined ? Link : undefined;
---

{Basic !== undefined && <Basic class="size-[18px]" aria-hidden="true" />}
{Generic !== undefined && <Generic class="size-[18px]" aria-hidden="true" />}
{brandBody !== undefined && (
  <svg
    class="size-[18px] text-zinc-700"
    viewBox={`0 0 ${brandWidth} ${brands.height}`}
    fill="currentColor"
    aria-hidden="true"
    set:html={brandBody}
  />
)}
