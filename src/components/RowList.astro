---
export interface Row {
  readonly title: string;
  /** Слева: год или период. Нет значения, значит колонка в строке пустая. */
  readonly aside?: string;
  /** Под названием, приглушённо. */
  readonly details?: string;
}

interface Props {
  readonly rows: readonly Row[];
}

const { rows } = Astro.props;
---

{rows.length > 0 && (
  <ul class="divide-border border-border divide-y border-y">
    {rows.map(({ title, aside, details }) => (
      <li class="reveal grid grid-cols-1 gap-x-6 gap-y-0.5 py-3 sm:grid-cols-[6.5rem_minmax(0,1fr)] print:py-2">
        {aside === undefined ? (
          <span aria-hidden="true" class="hidden sm:block" />
        ) : (
          <p class="text-muted-foreground text-sm leading-snug tabular-nums sm:pt-px">{aside}</p>
        )}
        <div class="min-w-0">
          <h3 class="text-base leading-snug font-medium tracking-tight">{title}</h3>
          {details !== undefined && details !== '' && (
            <p class="text-muted-foreground text-sm">{details}</p>
          )}
        </div>
      </li>
    ))}
  </ul>
)}
