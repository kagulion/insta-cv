---
interface Props {
  readonly id: string;
  readonly title: string;
}

const { id, title } = Astro.props;
const titleId = `${id}-title`;
---

<section id={id} aria-labelledby={titleId} class="reveal scroll-mt-4 pt-8 print:pt-8">
  <h2
    id={titleId}
    class="text-foreground mb-4 print:mb-2 text-xl leading-normal font-medium tracking-tight"
  >
    {title}
  </h2>
  <slot />
</section>
