---
import logotype from '../assets/logotype.svg';
import type { FooterLines } from '../lib/footer';

type Props = FooterLines;

const { copyright, credit, logo } = Astro.props;
---

<footer class="reveal mt-auto pt-14 print:hidden">
  <div class="border-border flex items-center justify-between gap-4 border-t py-6">
    <p class="text-muted-foreground text-sm">{copyright}</p>
    {logo && (
      <img
        src={logotype.src}
        width={logotype.width}
        height={logotype.height}
        alt={credit}
        class="h-5 w-auto shrink-0"
      />
    )}
  </div>
</footer>
