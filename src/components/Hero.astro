---
import type { LinkItem } from '../lib/contact-links';
import { CONTACTS_ID, splitParagraphs } from '../lib/page-sections';
import ContactIcon from './ContactIcon.astro';
import PrintButton from './PrintButton.astro';

interface Props {
  readonly name: string;
  readonly position: string;
  /** Город в одном блоке с именем и специализацией. Нет значения, значит строки нет. */
  readonly location?: string;
  /** Текст «О себе» под специализацией, без заголовка. */
  readonly about: string;
  readonly contactsTitle: string;
  readonly contacts: readonly LinkItem[];
  /** Подпись кнопки печати. Нет значения, значит кнопки и скрипта нет. */
  readonly printLabel?: string;
}

const { name, position, location, about, contactsTitle, contacts, printLabel } = Astro.props;
const paragraphs = splitParagraphs(about);
// tel: и mailto: открывает система, новое окно нужно только веб-ссылкам.
const isWeb = (href: string): boolean => /^https?:/i.test(href);
const titleId = `${CONTACTS_ID}-title`;
---

<header class="pt-12 sm:pt-16 print:py-4">
  <div class="flex items-start justify-between gap-4 sm:gap-6">
    <div class="min-w-0">
      <div class="enter font-normal tracking-tight">
        <h1 class="text-2xl font-medium">{name}</h1>
        <p class="text-muted-foreground mt-0.5 flex flex-col text-base sm:flex-row sm:flex-wrap sm:items-baseline sm:gap-x-4">
          <span>{position}</span>
          {location !== undefined && (
            <span class="sm:flex sm:items-baseline sm:gap-x-4">
              <span
                aria-hidden="true"
                class="hidden size-[3px] self-center bg-current sm:inline-block print:size-[2px]"
              />
              {location}
            </span>
          )}
        </p>
      </div>
      {paragraphs.length > 0 && (
        <div
          style="--i: 1"
          class="enter mt-8 space-y-4 print:mt-4 text-base leading-relaxed text-pretty"
        >
          {paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      )}
    </div>
  </div>
  <section id={CONTACTS_ID} aria-labelledby={titleId} class="enter mt-8 print:mt-4" style="--i: 2">
    <h2 id={titleId} class="sr-only">
      {contactsTitle}
    </h2>
    <ul class="flex flex-row flex-wrap items-start gap-2 print:gap-x-6 print:gap-y-2">
      {contacts.map(({ kind, display, href, icon }) => (
        <li class="max-w-full min-w-0 wrap-anywhere">
          <a
            class="icon-button"
            href={href}
            title={display}
            {...(isWeb(href) && { target: '_blank', rel: 'noopener noreferrer' })}
          >
            <span class="inline-flex print:hidden">
              <ContactIcon kind={kind} icon={icon} />
            </span>
            <span class="sr-only print:not-sr-only">{display}</span>
          </a>
        </li>
      ))}
      {printLabel !== undefined && <PrintButton label={printLabel} />}
    </ul>
  </section>
</header>
