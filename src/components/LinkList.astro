---
import ExternalLink from './ExternalLink.astro';

interface Props {
  readonly items: readonly { readonly text: string; readonly url?: string }[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <ul class="space-y-1">
    {items.map(({ text, url }) => (
      <li class="relative pl-5 text-sm wrap-anywhere text-pretty">
        <span aria-hidden="true" class="bg-muted-foreground absolute top-[0.7em] left-0 h-px w-3" />
        {url !== undefined ? <ExternalLink href={url}>{text}</ExternalLink> : text}
      </li>
    ))}
  </ul>
)}
