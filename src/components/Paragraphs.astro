---
import { splitParagraphs } from '../lib/page-sections';

interface Props {
  readonly text: string;
}

const paragraphs = splitParagraphs(Astro.props.text);
---

<div class="text-foreground space-y-4 text-sm leading-relaxed">
  {paragraphs.map((paragraph) => (
    <p>{paragraph}</p>
  ))}
</div>
